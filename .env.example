# Copy to .env and adjust. .env is gitignored; this template is committed.
# Local-only dev credentials — fine to be simple since nothing is exposed off-machine.
POSTGRES_USER=footnote
POSTGRES_PASSWORD=footnote
POSTGRES_DB=footnote
POSTGRES_PORT=5432

# SQLAlchemy connection URL. The +psycopg suffix selects the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://footnote:footnote@localhost:5432/footnote
